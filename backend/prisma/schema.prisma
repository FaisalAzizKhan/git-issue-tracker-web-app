datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model users {
  users_id                        String              @id @default(uuid()) @db.Uuid
  email                           String              @unique
  phone                           String?
  full_name                       String?
  last_name                       String?
  first_name                      String?
  password                        String
  profile_image                   String?
  created_at                      DateTime            @default(now())
  updated_at                      DateTime            @updatedAt
  is_deleted                      Boolean             @default(false)
  is_active                       Boolean             @default(true)

  issue                           issue[]             

}

model issue {

  issue_id                        String              @id @default(uuid()) @db.Uuid
  title                           String
  variant                         String?

  description                     String?
  labels                          String[]   
  status                          Status              @default(IN_PROGRESS)
  priority                        Priority            @default(MEDIUM)
  assignee                        String?
  created_at                       DateTime            @default(now())
  is_opened                       Boolean             @default(true)

  users_id                        String?             @db.Uuid
  users                           users?              @relation(fields: [users_id], references: [users_id], onDelete: Cascade)

}

enum Status {
  CLOSED
  IN_PROGRESS
  OPEN
  REVIEW
}

enum Priority {
  HIGH
  MEDIUM
  LOW
}